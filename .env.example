# Copia este archivo a .env.local y rellena las claves

# ── Cerebro (Anthropic — fallback) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Cerebro (Azure AI Foundry — principal) ───────────────────────────────────
# Crea un recurso AIServices en Azure Portal y despliega gpt-4.1-mini
AZURE_AI_PROJECT_ENDPOINT=https://<tu-recurso>.openai.azure.com
AZURE_AI_API_KEY=<tu-api-key-azure>
AZURE_AI_DEPLOYMENT=gpt-4.1-mini

# ── Voz (Groq Whisper) ────────────────────────────────────────────────────────
# Gratis en console.groq.com
GROQ_API_KEY=gsk_...

# ── Base de datos (Neon Postgres) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=<secreto-de-32-chars>
NEXT_PUBLIC_APP_URL=http://localhost:3000
